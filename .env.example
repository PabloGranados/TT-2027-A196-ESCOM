# Copia este archivo como ".env" y cambia los valores. El archivo ".env" NO se sube a GitHub.

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=escom_user
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=hardware_match_db

# --- Backend (FastAPI) ---
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TTL_SECONDS=3600
# Usa true cuando el sitio se sirva por HTTPS
COOKIE_SECURE=false

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000

# --- Cuenta de demostración (opcional, solo desarrollo local) ---
# Si defines la contraseña, se crea/usa esta cuenta para los datos de ejemplo y el
# login muestra el botón "Autocompletar". Déjala vacía para desactivar la cuenta demo.
DEMO_USER_EMAIL=demo.escom@ipn.mx
DEMO_USER_PASSWORD=

